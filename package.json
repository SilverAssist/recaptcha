{
  "name": "@silverassist/recaptcha",
  "version": "0.3.1",
  "description": "Google reCAPTCHA v3 integration for Next.js applications with Server Actions support",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "prettier": "@silverassist/npm-package-standards/prettier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/recaptcha.git"
  },
  "bugs": {
    "url": "https://github.com/SilverAssist/recaptcha/issues"
  },
  "homepage": "https://github.com/SilverAssist/recaptcha#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "recaptcha",
    "recaptcha-v3",
    "google-recaptcha",
    "nextjs",
    "next",
    "react",
    "server-actions",
    "spam-protection",
    "bot-detection"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants/index.d.mts",
        "default": "./dist/constants/index.mjs"
      },
      "require": {
        "types": "./dist/constants/index.d.ts",
        "default": "./dist/constants/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ],
      "constants": [
        "./dist/constants/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run build && npm run test",
    "release": "npm run prepublishOnly && npm publish --access public",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "prepare": "husky || true",
    "e2e:setup": "next-testing-toolkit build-fixture --port 3210",
    "e2e": "npm run e2e:setup && playwright test -c e2e/playwright.config.ts"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@silverassist/copilot-prompts-kit": "^2.0.0",
    "@silverassist/next-testing-toolkit": "^0.2.0",
    "@silverassist/npm-package-standards": "^0.1.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^17.3.0",
    "next": "^16.1.5",
    "prettier": "^3.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "js-yaml": "^3.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "cypress@15.21.0": true
  }
}

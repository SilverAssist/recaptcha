{
  "extends": "@silverassist/npm-package-standards/tsconfig/react",
  "compilerOptions": {
    // rootDir/outDir/include/exclude are deliberately not in the shared base:
    // TypeScript resolves path-valued compilerOptions in an extended config
    // relative to *that config file's own location*, not the consumer's --
    // so every consumer must declare these itself.
    "outDir": "./dist",
    "rootDir": "./src",
    // Also required, even though it isn't path-valued: extending a config
    // from a different package resolves lib.*.d.ts inconsistently when that
    // package's own typescript version differs from this one -- restating
    // it is the confirmed fix.
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // TS 6 no longer auto-includes @types/node the way TS 7 does; without this
    // `process` and the NodeJS namespace are unresolved in the client and
    // server entrypoints.
    "types": ["node"],
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      // The barrel self-references this subpath to keep the "use client"
      // module boundary intact through the build. At type-check time dist/
      // may not exist yet, so point TypeScript at the source instead of the
      // exports map -- otherwise `tsc --noEmit` fails on a clean checkout.
      "@silverassist/recaptcha/client": ["./src/client/index.tsx"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
